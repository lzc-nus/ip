<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="560.0"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="greenchonk.gui.MainWindow">
    <children>
        <VBox styleClass="app-shell"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">
            <children>
                <VBox spacing="4.0" styleClass="app-header">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <VBox spacing="2.0">
                                    <children>
                                        <Label styleClass="app-title" text="GREEN CHONK" />
                                        <Label styleClass="app-subtitle" text="YOUR LOCAL TASK COMPANION" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="status-pill" text="●  READY" />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="20.0" left="24.0" right="24.0" top="22.0" />
                    </padding>
                </VBox>
                <ScrollPane fx:id="scrollPane"
                            fitToWidth="true"
                            hbarPolicy="NEVER"
                            pannable="true"
                            styleClass="dialog-scroll"
                            vbarPolicy="AS_NEEDED"
                            VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="dialogContainer"
                              fillWidth="true"
                              spacing="8.0"
                              styleClass="dialog-container">
                            <padding>
                                <Insets bottom="18.0" left="10.0" right="10.0" top="18.0" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>
                <VBox spacing="8.0" styleClass="composer-panel">
                    <children>
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <TextField fx:id="userInput"
                                           onAction="#handleUserInput"
                                           promptText="Type a command, e.g. todo read chapter 4"
                                           styleClass="command-input"
                                           HBox.hgrow="ALWAYS" />
                                <Button mnemonicParsing="false"
                                        onAction="#handleUserInput"
                                        styleClass="send-button"
                                        text="CHOMP" />
                            </children>
                        </HBox>
                        <Label styleClass="keyboard-hint"
                               text="Press Enter to send  •  Type bye to close" />
                    </children>
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="14.0" />
                    </padding>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
